<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:spacing="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LlamaMobile Android Library Example"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Model Selection -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Model:" 
                android:textStyle="bold"
                android:textSize="16sp"/>
            <Spinner
                android:id="@+id/modelSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#F2F2F7"
                android:padding="16dp"
                android:cornerRadius="8dp"
                android:borderWidth="1dp"
                android:borderColor="#000000"/>
        </LinearLayout>

        <!-- Vocoder Model Selection -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Vocoder Model:" 
                android:textStyle="bold"
                android:textSize="16sp"/>
            <Spinner
                android:id="@+id/vocoderModelSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#F2F2F7"
                android:padding="16dp"
                android:cornerRadius="8dp"
                android:borderWidth="1dp"
                android:borderColor="#000000"/>
        </LinearLayout>

        <!-- Projection File Selection -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Projection File:" 
                android:textStyle="bold"
                android:textSize="16sp"/>
            <Spinner
                android:id="@+id/projectionFileSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#F2F2F7"
                android:padding="16dp"
                android:cornerRadius="8dp"
                android:borderWidth="1dp"
                android:borderColor="#000000"/>
        </LinearLayout>

        <!-- Buttons Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp"
            android:weightSum="2">
            <Button
                android:id="@+id/initializeButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Initialize"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:backgroundTint="#F2F2F7"
                android:textColor="@android:color/black"
                android:cornerRadius="8dp"
                android:borderWidth="1dp"
                android:borderColor="#000000"
                android:padding="16dp" />
            <Button
                android:id="@+id/generateButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Generate"
                android:layout_weight="1"
                android:layout_marginStart="8dp" 
                android:enabled="false"
                android:backgroundTint="#F2F2F7"
                android:textColor="@android:color/black"
                android:cornerRadius="8dp"
                android:borderWidth="1dp"
                android:borderColor="#000000"
                android:padding="16dp" />
        </LinearLayout>

        <!-- Buttons Row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp"
            android:weightSum="3">
            <Button
                android:id="@+id/conversationButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Conversation"
                android:layout_weight="1"
                android:layout_marginEnd="4dp" 
                android:enabled="false"
                android:backgroundTint="#F2F2F7"
                android:textColor="@android:color/black"
                android:cornerRadius="8dp"
                android:borderWidth="1dp"
                android:borderColor="#000000"
                android:padding="16dp" />
            <Button
                android:id="@+id/embeddingButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Embedding"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp" 
                android:enabled="false"
                android:backgroundTint="#F2F2F7"
                android:textColor="@android:color/black"
                android:cornerRadius="8dp"
                android:borderWidth="1dp"
                android:borderColor="#000000"
                android:padding="16dp" />
            <Button
                android:id="@+id/completeButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Complete"
                android:layout_weight="1"
                android:layout_marginStart="4dp" 
                android:enabled="false"
                android:backgroundTint="#F2F2F7"
                android:textColor="@android:color/black"
                android:cornerRadius="8dp"
                android:borderWidth="1dp"
                android:borderColor="#000000"
                android:padding="16dp" />
        </LinearLayout>

        <!-- Buttons Row 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp"
            android:weightSum="2">
            <Button
                android:id="@+id/multimodalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Multimodal"
                android:layout_weight="1"
                android:layout_marginEnd="8dp" 
                android:enabled="false"
                android:backgroundTint="#F2F2F7"
                android:textColor="@android:color/black"
                android:cornerRadius="8dp"
                android:borderWidth="1dp"
                android:borderColor="#000000"
                android:padding="16dp" />
            <Button
                android:id="@+id/ttsButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="TTS"
                android:layout_weight="1"
                android:layout_marginStart="8dp" 
                android:enabled="false"
                android:backgroundTint="#F2F2F7"
                android:textColor="@android:color/black"
                android:cornerRadius="8dp"
                android:borderWidth="1dp"
                android:borderColor="#000000"
                android:padding="16dp" />
        </LinearLayout>

        <!-- Image Picker -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">
            <Button
                android:id="@+id/imagePickerButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Select Image"
                android:layout_marginBottom="8dp" 
                android:enabled="false"
                android:backgroundTint="#F2F2F7"
                android:textColor="@android:color/black"
                android:cornerRadius="8dp"
                android:borderWidth="1dp"
                android:borderColor="#000000"
                android:padding="16dp" />
            <ImageView
                android:id="@+id/selectedImageView"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:scaleType="centerCrop"
                android:background="@android:color/darker_gray"
                android:contentDescription="Selected image for multimodal testing"/>
        </LinearLayout>

        <!-- Prompt Input -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Prompt:" 
                android:textStyle="bold"
                android:textSize="16sp"/>
            <EditText
                android:id="@+id/promptEditText"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:hint="Enter your prompt here..."
                android:inputType="textMultiLine"
                android:gravity="top"
                android:padding="16dp"
                android:backgroundTint="#F2F2F7"
                android:textColor="@android:color/black"
                android:layout_marginBottom="8dp"
                android:cornerRadius="8dp"
                android:borderWidth="1dp"
                android:borderColor="#000000"/>
        </LinearLayout>

        <!-- Output Display -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Output:" 
                android:textStyle="bold"
                android:textSize="16sp"/>
            <TextView
                android:id="@+id/outputTextView"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:backgroundTint="#F2F2F7"
                android:padding="16dp"
                android:gravity="top"
                android:text="No output yet"
                android:textColor="@android:color/black"
                android:scrollbars="vertical"
                android:layout_marginBottom="8dp"
                android:cornerRadius="8dp"
                android:borderWidth="1dp"
                android:borderColor="#000000"/>
        </LinearLayout>

        <!-- TTS Audio Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp"
            android:weightSum="2">
            <Button
                android:id="@+id/playAudioButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Play Audio"
                android:layout_weight="1"
                android:layout_marginEnd="8dp" 
                android:enabled="false"
                android:backgroundTint="#F2F2F7"
                android:textColor="@android:color/black"
                android:cornerRadius="8dp"
                android:borderWidth="1dp"
                android:borderColor="#000000"
                android:padding="16dp" />
            <Button
                android:id="@+id/stopAudioButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Stop Audio"
                android:layout_weight="1"
                android:layout_marginStart="8dp" 
                android:enabled="false"
                android:backgroundTint="#F2F2F7"
                android:textColor="@android:color/black"
                android:cornerRadius="8dp"
                android:borderWidth="1dp"
                android:borderColor="#000000"
                android:padding="16dp" />
        </LinearLayout>

        <!-- Debug Log -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Debug Log:" 
                android:textStyle="bold"
                android:textSize="16sp"/>
            <TextView
                android:id="@+id/debugLogTextView"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:backgroundTint="#F2F2F7"
                android:padding="16dp"
                android:gravity="top"
                android:text="Debug log will appear here..."
                android:textSize="12sp"
                android:textColor="@android:color/black"
                android:scrollbars="vertical"
                android:layout_marginBottom="8dp"
                android:cornerRadius="8dp"
                android:borderWidth="1dp"
                android:borderColor="#000000"/>
        </LinearLayout>

        <!-- Clear Button -->
        <Button
            android:id="@+id/clearButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Clear"
            android:layout_marginBottom="24dp"
            android:backgroundTint="#F2F2F7"
            android:textColor="@android:color/black"
            android:cornerRadius="8dp"
            android:borderWidth="1dp"
            android:borderColor="#000000"
            android:padding="16dp" />

        <!-- Activity Indicator -->
        <ProgressBar
            android:id="@+id/activityIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>