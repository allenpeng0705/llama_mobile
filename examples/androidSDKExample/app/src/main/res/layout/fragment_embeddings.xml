<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".EmbeddingsFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Section: Input Text -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardElevation="2dp"
            app:cardCornerRadius="8dp"
            app:cardBackgroundColor="?android:attr/colorBackgroundFloating"
            app:contentPadding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Input Text"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="12dp"
                android:textColor="@android:color/black" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxBackgroundColor="@android:color/background_light">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/embedEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Enter text to generate embeddings..."
                    android:inputType="textMultiLine"
                    android:maxLines="5"
                    android:minLines="3"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif"
                    android:padding="12dp" />
            </com.google.android.material.textfield.TextInputLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Section: Action Button -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardElevation="2dp"
            app:cardCornerRadius="8dp"
            app:cardBackgroundColor="?android:attr/colorBackgroundFloating"
            app:contentPadding="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/generateEmbeddingsButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Generate Embeddings"
                android:enabled="false"
                android:layout_marginBottom="12dp"
                android:textSize="16sp"
                android:textAllCaps="false"
                android:backgroundTint="#2196F3"
                app:cornerRadius="24dp"
                app:elevation="2dp" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center_horizontal"
                android:visibility="gone"
                android:layout_marginBottom="8dp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Section: Embeddings Result -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardElevation="2dp"
            app:cardCornerRadius="8dp"
            app:cardBackgroundColor="?android:attr/colorBackgroundFloating"
            app:contentPadding="16dp"
            android:id="@+id/embeddingsSection"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Embedding Result"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="12dp"
                    android:textColor="@android:color/black" />

                <TextView
                    android:id="@+id/embeddingsTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No embeddings yet"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:textColor="@android:color/black"
                    android:lineSpacingExtra="4dp"
                    android:scrollHorizontally="false"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Section: Status -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardElevation="2dp"
            app:cardCornerRadius="8dp"
            app:cardBackgroundColor="?android:attr/colorBackgroundFloating"
            app:contentPadding="16dp">

            <TextView
                android:id="@+id/statusTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Model not loaded"
                android:textSize="14sp"
                android:textStyle="italic"
                android:textColor="@android:color/holo_red_dark"
                android:gravity="center_horizontal"
                android:paddingVertical="8dp" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
