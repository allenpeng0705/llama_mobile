<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".TTSTestFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <!-- Back Button -->
    <Button
        android:id="@+id/backButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Back"
        android:backgroundTint="@android:color/holo_blue_dark"
        android:textColor="@android:color/white"
        android:layout_marginBottom="16dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp" />

    <!-- Text Input Section -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Text Input"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/ttsTextEditText"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:hint="Enter text to convert to speech..."
        android:inputType="textMultiLine"
        android:gravity="top"
        android:padding="12dp"
        android:layout_marginBottom="16dp"
        android:background="@android:drawable/editbox_background_normal" />

    <!-- Vocoder Model Section -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Vocoder Model"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/vocoderModelTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No vocoder files found for TTS"
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/vocoderStatusTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Vocoder not enabled"
            android:textSize="14sp"
            android:textColor="@android:color/holo_red_dark"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/ttsModelTypeTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TTS Model Type: Unknown"
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray" />
    </LinearLayout>

    <!-- Feature Toggles -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Save to File"
            android:textSize="16sp" />

        <Switch
            android:id="@+id/saveToFileToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="" />
    </LinearLayout>

    <!-- Action Buttons Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/generateSpeechAsyncButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Generate Speech(Async)"
            android:enabled="false"
            android:layout_marginBottom="8dp"
            android:backgroundTint="@android:color/holo_blue_light"
            android:textColor="@android:color/white"
            android:padding="12dp" />

        <Button
            android:id="@+id/generateSpeechSyncButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Generate Speech(Sync)"
            android:enabled="false"
            android:layout_marginBottom="8dp"
            android:backgroundTint="@android:color/holo_blue_dark"
            android:textColor="@android:color/white"
            android:padding="12dp" />

        <Button
            android:id="@+id/playAudioButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Play Audio"
            android:enabled="false"
            android:backgroundTint="@android:color/holo_green_light"
            android:textColor="@android:color/white"
            android:padding="12dp" />
    </LinearLayout>

    <!-- Progress Indicator -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:visibility="gone"
        android:layout_marginBottom="16dp" />

    <!-- TTS Result Section -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="TTS Result"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/ttsStatusTextView"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:text="TTS status will appear here"
        android:textSize="14sp"
        android:padding="12dp"
        android:background="@android:drawable/dialog_frame"
        android:layout_marginBottom="16dp"
        android:gravity="top"
        android:scrollbars="vertical"
        android:textIsSelectable="true" />

    <!-- Model Status Section -->
    <TextView
        android:id="@+id/statusTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Model not loaded"
        android:textSize="14sp"
        android:textStyle="italic"
        android:textColor="@android:color/holo_red_dark"
        android:gravity="center_horizontal" />
    </LinearLayout>
</ScrollView>