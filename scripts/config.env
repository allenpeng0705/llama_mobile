# ============================================================================
# LLAMA MOBILE SDK CONFIGURATION FILE
# This file contains all environment variables needed for building different SDKs
# Build scripts will attempt to auto-detect these values, but you can set them
# manually if auto-detection fails.
# ============================================================================

# ----------------------------------------------------------------------------
# CORE LIBRARY BUILD VARIABLES
# ----------------------------------------------------------------------------

# CMake configuration
CMAKE_PATH=""                      # Path to CMake executable
CMAKE_BUILD_TYPE="Release"
CMAKE_JOBS="12"

# Compiler paths
CC=""                             # C compiler path
CXX=""                            # C++ compiler path
RC_COMPILER=""                     # Resource compiler path (Windows)

# Build paths
SDK_PATH=""                        # Path to SDK (auto-detected if empty)

# ----------------------------------------------------------------------------
# ANDROID SDK BUILD VARIABLES
# ----------------------------------------------------------------------------

# Android SDK configuration
ANDROID_HOME=""                    # Path to Android SDK root directory
NDK_PATH=""                        # Path to Android NDK (auto-detected if empty)
ANDROID_PLATFORM=""                # Minimum Android API level (auto-detected if empty, default: android-21)
ANDROID_BUILD_TYPE="Release"
ANDROID_ABIS="arm64-v8a,x86_64"

# ----------------------------------------------------------------------------
# iOS SDK BUILD VARIABLES
# ----------------------------------------------------------------------------

# iOS build configuration
IOS_BUILD_TYPE=""                 # Release or Debug build (default: Release)
IOS_SIMULATOR_ARCHES=""           # Simulator architectures (default: arm64,x86_64)
IOS_DEVICE_ARCHES=""              # Device architectures (default: arm64)
XCODE_PATH=""                      # Path to Xcode application

# ----------------------------------------------------------------------------
# FLUTTER SDK BUILD VARIABLES
# ----------------------------------------------------------------------------

# Flutter configuration
FLUTTER_HOME=""                    # Path to Flutter SDK
FLUTTER_BUILD_TYPE=""             # release or debug (default: release)

# ----------------------------------------------------------------------------
# REACT NATIVE SDK BUILD VARIABLES
# ----------------------------------------------------------------------------

# React Native configuration
NODE_PATH=""                       # Path to Node.js executable
NPM_PATH=""                        # Path to npm executable
YARN_PATH=""                       # Path to Yarn executable

# ----------------------------------------------------------------------------
# CAPACITOR PLUGIN BUILD VARIABLES
# ----------------------------------------------------------------------------

# Capacitor configuration
CAPACITOR_BUILD_TYPE=""           # release or debug (default: release)

# ----------------------------------------------------------------------------
# LOGGING AND BEHAVIOR
# ----------------------------------------------------------------------------

# Logging level (ERROR, WARN, INFO, DEBUG)
LOG_LEVEL=""                      # Default: INFO

# Build behavior flags
NO_CLEAN=""                       # Skip cleaning build directories (default: false)
KEEP_BUILD=""                     # Keep intermediate build files (default: false)
VERBOSE=""                        # Show verbose output (default: false)
